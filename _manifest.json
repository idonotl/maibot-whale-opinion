{
  "manifest_version": 2,
  "id": "local.whale-opinion",
  "version": "0.1.4",
  "name": "小鲸鱼观点与讨论",
  "description": "让麦麦在评价类话题上形成自己的判断：证据约束判断、关系影响表达，能被有效新信息说服，也能保留分歧。",
  "author": {
    "name": "idonotl",
    "url": "https://github.com/idonotl"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/idonotl/maibot-whale-opinion",
    "homepage": "https://github.com/idonotl/maibot-whale-opinion",
    "documentation": "https://github.com/idonotl/maibot-whale-opinion/blob/main/README.md",
    "issues": "https://github.com/idonotl/maibot-whale-opinion/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.19"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "extension",
  "dependencies": [],
  "capabilities": [
    "message.get_by_id",
    "message.get_by_time_in_chat",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
